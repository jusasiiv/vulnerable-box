# Copy to .env to override defaults. The compose file already sets working
# defaults, so .env is optional for a local run.

# Port the Node app listens on inside the container.
PORT=3000

# Secret used to sign JWTs. Intentionally weak default.
JWT_SECRET=devsecret

# SQLite database and upload locations (inside the container).
DB_PATH=/app/backend/data/app.db
UPLOAD_DIR=/app/backend/data/uploads

# Seeded accounts (see backend/seed/seed.sql):
#   admin / admin123   (role: admin)
#   alice / password1
#   bob   / hunter2
#   carol / letmein
